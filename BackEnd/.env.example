# --- Server ---
PORT=5000
NODE_ENV=development
# Used in email links (verification, password reset).
APP_URL=http://localhost:3000

# --- Database ---
MONGO_URI=mongodb://localhost:27017/Tradex

# --- Auth: JWT ---
# Use long random strings (>= 64 chars) in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string
JWT_REFRESH_SECRET=replace_me_with_a_different_long_random_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12

# --- Auth: cookies / CSRF ---
# Name of httpOnly refresh-token cookie.
REFRESH_COOKIE_NAME=tx_refresh
# Name of the CSRF cookie + header. Header is `x-csrf-token`.
CSRF_COOKIE_NAME=tx_csrf
# Set to "true" in production (behind HTTPS).
COOKIE_SECURE=false
# "strict" | "lax" | "none". Use "none" only if frontend is on a different site & you control HTTPS.
COOKIE_SAMESITE=strict

# --- Auth: account lockout ---
# Number of consecutive failed logins before lockout triggers.
LOCKOUT_MAX_ATTEMPTS=5
# How long an account stays locked (minutes).
LOCKOUT_DURATION_MIN=15

# --- Auth: tokens (verification & password reset) ---
EMAIL_VERIFY_TTL_HOURS=24
PASSWORD_RESET_TTL_MIN=30

# --- OAuth: Google ---
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- OAuth: Facebook ---
# https://developers.facebook.com/apps
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Email (nodemailer) ---
# Leave EMAIL_HOST blank in dev → falls back to a console transport (logs links).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="TradeX <no-reply@tradex.local>"

# --- CORS ---
# Comma-separated list of allowed origins. No wildcard in production.
CORS_ORIGINS=http://localhost:3000

# --- Trade safety ---
MAX_FUND_DEPOSIT=1000000
SELL_PRICE_TOLERANCE=0.10

# --- Indian paper trading ---
STARTING_CAPITAL=1000000

# --- Admin (corporate actions, IPO allotment) ---
ADMIN_TOKEN=replace_me_with_an_admin_only_token
